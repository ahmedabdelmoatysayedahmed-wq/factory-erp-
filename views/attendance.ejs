<%- include('partials/header', { title: 'الحضور والانصراف' }) %>
<div class="head">
  <h1><%= t('الحضور والانصراف') %></h1>
  <form method="get"><input type="date" name="date" value="<%= d %>" onchange="this.form.submit()"></form>
</div>
<% const editable = can('attendance', 'edit'); %>
<% if (offDay) { %><div class="flash info"><%= t('اليوم ده راحة أسبوعية، والكل متسجل «راحة» تلقائياً. لو حد اشتغل غيّر حالته لـ «حاضر» واحفظ.') %></div><% } %>
<form method="post" class="card">
  <input type="hidden" name="date" value="<%= d %>">
  <% if (editable) { %>
  <div class="btns">
    <button type="button" class="btn" onclick="markAll('present', <%= offDay %>)"><%= t('الكل حاضر') %></button>
    <button class="btn primary"><%= t('حفظ الحضور') %></button>
  </div>
  <% } %>
  <div class="table-wrap">
  <table class="att">
    <thead><tr><th><%= t('الموظف') %></th><th><%= t('الحالة') %></th><th><%= t('حضور') %></th><th><%= t('انصراف') %></th><th><%= t('ملاحظات') %></th></tr></thead>
    <tbody>
    <% for (const e of rows) { const st = e.status || (e.leave_type ? 'leave' : offDay ? 'off' : ''); %>
      <tr><td data-label="<%= t('الموظف') %>"><input type="hidden" name="emp" value="<%= e.id %>"><b><%= e.name %></b> <small><%= e.job_title || '' %></small>
        <% if (e.leave_type) { %><span class="tag t-leave"><%= t('إجازة معتمدة') %></span><% } %></td>
      <td data-label="<%= t('الحالة') %>"><select name="status_<%= e.id %>" class="st" <%= editable ? '' : 'disabled' %>><option value="">—</option>
        <% for (const [k, v] of Object.entries(STATUS.att)) { if (k === 'leave' && !settings.leavesEnabled && st !== 'leave') continue; %><option value="<%= k %>" <%= st === k ? 'selected' : '' %>><%= t(v) %></option><% } %></select></td>
      <td data-label="<%= t('حضور') %>"><input type="time" name="in_<%= e.id %>" value="<%= e.check_in || '' %>" <%= editable ? '' : 'disabled' %>></td>
      <td data-label="<%= t('انصراف') %>"><input type="time" name="out_<%= e.id %>" value="<%= e.check_out || '' %>" <%= editable ? '' : 'disabled' %>></td>
      <td data-label="<%= t('ملاحظات') %>"><input name="notes_<%= e.id %>" value="<%= e.notes || '' %>" <%= editable ? '' : 'disabled' %>></td></tr>
    <% } %>
    <% if (!rows.length) { %><tr><td colspan="5" class="empty"><%= t('أضف الموظفين أولاً من شاشة الموظفين') %></td></tr><% } %>
    </tbody>
  </table>
  </div>
</form>
<script>
function markAll(s, offDay) {
  document.querySelectorAll('select.st').forEach(function (el) {
    if (!el.value || (offDay && el.value === 'off')) { el.value = s; var tr = el.closest('tr'); var i = tr.querySelector('input[type=time]'); if (!i.value) i.value = '08:00'; }
  });
}
</script>
<%- include('partials/footer') %>

<%- include('partials/header', { title: imp.title }) %>
<h1><%= t(imp.title) %></h1>
<div class="card form">
  <p><%= t('اختار ملف Excel (.xlsx). الأعمدة دي بتتقري لو موجودة، وترتيبها مش مهم:') %></p>
  <p class="muted"><%= t(imp.columnsHint) %></p>
  <p class="muted"><%= t(imp.matchHint) %></p>
  <label><%= t('ملف Excel') %><input type="file" id="file" accept=".xlsx"></label>
  <div id="msg"></div>
  <div class="table-wrap" id="preview"></div>
  <div class="btns">
    <button class="btn primary" id="go" disabled><%= t('استيراد') %></button>
    <a class="btn" href="/r/<%= rk %>"><%= t('إلغاء') %></a>
  </div>
</div>
<script>
var URL_ = '/r/<%= rk %>/import';
var T = <%- JSON.stringify({ rows: t('صف في الملف - راجعهم ودوس استيراد'), done: t('تم: {0} جديد، و{1} اتحدثت بياناتهم'), go: t('رجوع للقائمة'),
  keys: imp.preview.map(function (c) { return c[0]; }), h: imp.preview.map(function (c) { return t(c[1]); }) }).replace(/</g, '\\u003c') %>;
var file = document.getElementById('file'), go = document.getElementById('go'), msg = document.getElementById('msg'), pv = document.getElementById('preview');
function esc(s) { return String(s == null ? '—' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
function send(preview) {
  return fetch(URL_ + (preview ? '?preview=1' : ''), { method: 'POST', body: file.files[0], headers: { 'content-type': 'application/octet-stream' } }).then(function (r) { return r.json(); });
}
file.onchange = function () {
  go.disabled = true; pv.innerHTML = ''; msg.innerHTML = '';
  if (!file.files[0]) return;
  send(true).then(function (j) {
    if (!j.ok) { msg.innerHTML = '<div class="flash err">' + esc(j.error) + '</div>'; return; }
    msg.innerHTML = '<div class="flash info">' + j.rows.length + ' ' + esc(T.rows) + '</div>';
    pv.innerHTML = '<table><thead><tr>' + T.h.map(function (h) { return '<th>' + esc(h) + '</th>'; }).join('') + '</tr></thead><tbody>' +
      j.rows.map(function (e) { return '<tr><td>' + T.keys.map(function (k) { return esc(e[k]); }).join('</td><td>') + '</td></tr>'; }).join('') + '</tbody></table>';
    go.disabled = false;
  });
};
go.onclick = function () {
  go.disabled = true;
  send(false).then(function (j) {
    if (!j.ok) { msg.innerHTML = '<div class="flash err">' + esc(j.error) + '</div>'; go.disabled = false; return; }
    pv.innerHTML = '';
    msg.innerHTML = '<div class="flash ok">' + esc(T.done.replace('{0}', j.added).replace('{1}', j.updated)) + '</div><a class="btn primary" href="/r/<%= rk %>">' + esc(T.go) + '</a>';
    go.style.display = 'none';
  });
};
</script>
<%- include('partials/footer') %>

<%- include('partials/header', { title: r.title }) %>
<div class="head">
  <h1><%= t(r.title) %> <small>(<%= rows.length %>)</small></h1>
  <% if (can(rk, 'edit')) { %><div class="btns" style="margin:0">
    <% if (rk === 'employees' || rk === 'molds') { %><a class="btn" href="/r/<%= rk %>/import">📥 <%= t('استيراد من Excel') %></a><% } %>
    <a class="btn primary" href="/r/<%= rk %>/new">+ <%= t('إضافة') %> <%= t(r.single) %></a></div><% } %>
</div>
<form class="filters card" method="get">
  <input name="q" value="<%= q %>" placeholder="<%= t('بحث...') %>">
  <% if (dateField) { %>
    <label><%= t('من') %> <input type="date" name="from" value="<%= query.from || '' %>"></label>
    <label><%= t('إلى') %> <input type="date" name="to" value="<%= query.to || '' %>"></label>
  <% } %>
  <% for (const f of filters) { %>
    <select name="<%= f.name %>"><option value=""><%= t(f.label) %>: <%= t('الكل') %></option>
      <% for (const c of f.choices) { %><option value="<%= c.value %>" <%= String(query[f.name]) === String(c.value) ? 'selected' : '' %>><%= f.type === 'select' ? t(c.label) : c.label %></option><% } %>
    </select>
  <% } %>
  <button class="btn"><%= t('تصفية') %></button> <a href="/r/<%= rk %>"><%= t('مسح') %></a>
</form>
<% const cols = [...r.fields.filter(f => f.list && fieldOn(f)), ...(r.computed || [])]; %>
<div class="table-wrap card">
<table>
  <thead><tr><% for (const f of cols) { %><th><%= t(f.label) %></th><% } %><% if (can(rk, 'edit')) { %><th></th><% } %></tr></thead>
  <tbody>
  <% if (!rows.length) { %><tr><td colspan="<%= cols.length + 1 %>" class="empty"><%= t('لا توجد بيانات') %></td></tr><% } %>
  <% for (const row of rows) { %>
    <tr>
      <% for (const f of cols) { %><td class="<%= f.warn && f.warn(row) ? 'warn' : '' %>" data-label="<%= t(f.label) %>"><%- include('partials/cell', { f, row, refs }) %></td><% } %>
      <% if (can(rk, 'edit')) { %>
      <td class="actions">
        <a href="/r/<%= rk %>/<%= row.id %>/edit"><%= t('تعديل') %></a>
        <form method="post" action="/r/<%= rk %>/<%= row.id %>/delete" class="inline" onsubmit="return confirm('<%= t('متأكد من الحذف؟') %>')"><button class="link danger"><%= t('حذف') %></button></form>
      </td><% } %>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
<%- include('partials/footer') %>

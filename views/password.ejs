<%- include('partials/header', { title: 'تغيير كلمة المرور' }) %>
<h1>تغيير كلمة المرور</h1>
<form method="post" class="card form narrow">
  <% if (error) { %><div class="flash err"><%= error %></div><% } %>
  <label>كلمة المرور الحالية<input type="password" name="old" required></label>
  <label>كلمة المرور الجديدة<input type="password" name="new" required minlength="6"></label>
  <button class="btn primary">حفظ</button>
</form>
<%- include('partials/footer') %>

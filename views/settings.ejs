<%- include('partials/header', { title: 'الإعدادات' }) %>
<h1><%= t('الإعدادات') %></h1>
<form method="post" class="card form narrow">
  <fieldset class="days"><legend><%= t('أيام الراحة الأسبوعية') %></legend>
    <% DAYS.forEach((d, i) => { %>
      <label class="chk"><input type="checkbox" name="weekly_off" value="<%= i %>" <%= settings.weeklyOff.includes(i) ? 'checked' : '' %>> <%= t(d) %></label>
    <% }) %>
    <small><%= t('أيام الراحة مابتتحسبش غياب، وشاشة الحضور بتسجلها «راحة» تلقائياً.') %></small>
  </fieldset>
  <label><%= t('بداية الوردية النهاري (الساعة)') %><input type="number" name="shift_start_hour" min="0" max="23" value="<%= db_shift_start %>"></label>
  <label><%= t('دقايق تسجيل بيانات الساعة والصورة/الفيديو بعد كل ساعة') %><input type="number" name="hourly_window_min" min="1" max="60" value="<%= db_window %>"></label>
  <small class="muted"><%= t('لو الدقايق دي عدّت من غير البيانات والصورة أو الفيديو، الساعة بتتقفل وتتحسب ماشتغلش، والمشرف بس يعدّلها.') %></small>
  <label><%= t('أقل رصيد للمنتج قبل التنبيه (الحد العام)') %><input type="number" name="product_min_stock" min="0" value="<%= settings.productMinStock %>"></label>
  <small class="muted"><%= t('لو رصيد أي منتج نزل تحت الرقم ده يطلع تنبيه إنه محتاج إنتاج. وتقدر تحط حد مختلف لكل منتج من شاشة المنتجات.') %></small>
  <label class="chk"><input type="checkbox" name="leaves_enabled" value="1" <%= settings.leavesEnabled ? 'checked' : '' %>> <%= t('تفعيل قسم الإجازات') %></label>
  <small class="muted"><%= t('لو المصنع بدأ يدي إجازات (اعتيادية، مرضية، ...) فعّل القسم ده.') %></small>
  <div class="btns"><button class="btn primary"><%= t('حفظ') %></button></div>
</form>

<form method="post" action="/settings/mail" class="card form narrow" id="mail">
  <h2>📧 <%= t('تقرير الوردية بالإيميل') %></h2>
  <p class="muted"><%= t('بعد ما كل وردية تخلص (النهاري الساعة 8 بالليل، والليلي الساعة 8 الصبح) البرنامج بيبعت تقريرها أوتوماتيك.') %></p>
  <label class="chk"><input type="checkbox" name="mail_enabled" value="1" <%= mail.enabled ? 'checked' : '' %>> <%= t('ابعت التقرير أوتوماتيك') %></label>
  <label><%= t('يتبعت لـ (إيميل أو أكتر، بينهم فاصلة)') %><input name="mail_to" value="<%= mail.to.join(', ') %>" placeholder="name@gmail.com" dir="ltr"></label>
  <label><%= t('إيميل الإرسال (Gmail)') %><input name="mail_user" value="<%= mail.user %>" placeholder="factory@gmail.com" dir="ltr" autocomplete="off"></label>
  <label><%= t('كلمة سر التطبيقات (App Password)') %><input name="mail_pass" type="password" placeholder="<%= mail.pass ? t('متسجلة — سيبها فاضية علشان متتغيرش') : 'xxxx xxxx xxxx xxxx' %>" dir="ltr" autocomplete="new-password"></label>
  <small class="muted"><%= t('من حساب Google: الأمان ← التحقق بخطوتين (لازم يبقى شغال) ← كلمات مرور التطبيقات ← اعمل واحدة باسم Factory وانسخ الـ 16 حرف هنا.') %></small>
  <details><summary class="muted"><%= t('سيرفر تاني غير Gmail') %></summary>
    <label>SMTP host<input name="mail_host" value="<%= mail.host %>" dir="ltr"></label>
    <label>SMTP port<input name="mail_port" type="number" value="<%= mail.port %>" dir="ltr"></label></details>
  <% if (mail.lastSent) { %><p class="muted">✅ <%= t('آخر تقرير اتبعت') %>: <%= mail.lastSent %></p><% } %>
  <% if (mail.lastError) { %><p class="warn">⚠️ <%= t('آخر مشكلة') %>: <%= mail.lastError %></p><% } %>
  <div class="btns"><button class="btn primary"><%= t('حفظ') %></button>
    <button class="btn" formaction="/settings/mail-test"><%= t('ابعت إيميل تجريبي') %></button></div>
</form>

<form method="post" action="/settings/demo" class="card form narrow" onsubmit="return confirm('<%= t('ده هيمسح كل البيانات ما عدا الموظفين والمستخدمين. متأكد؟') %>')">
  <h2><%= t('بيانات تجريبية للتجربة') %></h2>
  <p class="muted"><%= t('بيضيف ماكينات وإسطمبات ومواد خام وأوامر تشغيل، وحضور وإنتاج آخر أسبوعين على الموظفين الموجودين، علشان تشوف شكل البرنامج. بيمسح أي بيانات تانية موجودة (ما عدا الموظفين والمستخدمين).') %></p>
  <label class="chk"><input type="checkbox" name="reset_employees" value="1" <%= noEmployees ? 'checked' : '' %>> <%= t('استخدم قائمة موظفين المصنع (16 موظف) بدل الموظفين الحاليين') %></label>
  <button class="btn"><%= t('إضافة بيانات تجريبية') %></button>
</form>

<form method="post" action="/settings/clear" class="card form narrow danger-zone">
  <h2><%= t('مسح البيانات (بداية جديدة)') %></h2>
  <p class="muted"><%= t('استخدمه لما تخلص تجربة وتبدأ تشغيل حقيقي. المستخدمين والإعدادات مابيتمسحوش.') %></p>
  <label class="chk"><input type="checkbox" name="keep_employees" value="1" checked> <%= t('احتفظ بالموظفين') %></label>
  <label class="chk"><input type="checkbox" name="keep_molds" value="1" checked> <%= t('احتفظ بالإسطمبات والمنتجات والإسطمبات القادمة') %></label>
  <label><%= t('للتأكيد اكتب كلمة: مسح') %><input name="confirm" autocomplete="off" required></label>
  <button class="btn danger-btn"><%= t('مسح البيانات') %></button>
</form>
<%- include('partials/footer') %>

<%- include('partials/header', { title: 'الإعدادات' }) %>
<h1><%= t('الإعدادات') %></h1>
<form method="post" class="card form narrow">
  <fieldset class="days"><legend><%= t('أيام الراحة الأسبوعية') %></legend>
    <% DAYS.forEach((d, i) => { %>
      <label class="chk"><input type="checkbox" name="weekly_off" value="<%= i %>" <%= settings.weeklyOff.includes(i) ? 'checked' : '' %>> <%= t(d) %></label>
    <% }) %>
    <small><%= t('أيام الراحة مابتتحسبش غياب، وشاشة الحضور بتسجلها «راحة» تلقائياً.') %></small>
  </fieldset>
  <label class="chk"><input type="checkbox" name="leaves_enabled" value="1" <%= settings.leavesEnabled ? 'checked' : '' %>> <%= t('تفعيل قسم الإجازات') %></label>
  <small class="muted"><%= t('لو المصنع بدأ يدي إجازات (اعتيادية، مرضية، ...) فعّل القسم ده.') %></small>
  <div class="btns"><button class="btn primary"><%= t('حفظ') %></button></div>
</form>

<form method="post" action="/settings/demo" class="card form narrow" onsubmit="return confirm('<%= t('ده هيمسح كل البيانات ما عدا الموظفين والمستخدمين. متأكد؟') %>')">
  <h2><%= t('بيانات تجريبية للتجربة') %></h2>
  <p class="muted"><%= t('بيضيف ماكينات وإسطمبات ومواد خام وأوامر تشغيل، وحضور وإنتاج آخر أسبوعين على الموظفين الموجودين، علشان تشوف شكل البرنامج. بيمسح أي بيانات تانية موجودة (ما عدا الموظفين والمستخدمين).') %></p>
  <label class="chk"><input type="checkbox" name="reset_employees" value="1" <%= noEmployees ? 'checked' : '' %>> <%= t('استخدم قائمة موظفين المصنع (16 موظف) بدل الموظفين الحاليين') %></label>
  <button class="btn"><%= t('إضافة بيانات تجريبية') %></button>
</form>

<form method="post" action="/settings/clear" class="card form narrow danger-zone">
  <h2><%= t('مسح البيانات (بداية جديدة)') %></h2>
  <p class="muted"><%= t('استخدمه لما تخلص تجربة وتبدأ تشغيل حقيقي. المستخدمين والإعدادات مابيتمسحوش.') %></p>
  <label class="chk"><input type="checkbox" name="keep_employees" value="1" checked> <%= t('احتفظ بالموظفين') %></label>
  <label><%= t('للتأكيد اكتب كلمة: مسح') %><input name="confirm" autocomplete="off" required></label>
  <button class="btn danger-btn"><%= t('مسح البيانات') %></button>
</form>
<%- include('partials/footer') %>

<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? t(title) + ' | ' : '' %><%= t('إدارة المصنع') %></title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<% const langLink = lang === 'ar' ? ['/lang/en', 'English'] : ['/lang/ar', 'عربي']; %>
<% if (user) {
  const groups = [
    ['الرئيسية', [['/', 'لوحة التحكم', 'dashboard'], ['/reports', 'تقارير الإنتاجية', 'reports']]],
    ['الإنتاج', [['/r/production_logs', 'الإنتاج اليومي', 'production_logs'], ['/r/production_orders', 'أوامر التشغيل', 'production_orders'], ['/r/products', 'المنتجات', 'products']]],
    ['المعدات', [['/r/machines', 'الماكينات', 'machines'], ['/r/molds', 'الإسطمبات', 'molds'], ['/r/upcoming_molds', 'الإسطمبات القادمة', 'upcoming_molds', 'sub'], ['/r/assets', 'الأصول', 'assets']]],
    ['المخزن', [['/r/materials', 'المواد الخام', 'materials'], ['/r/stock_movements', 'حركات المخزن', 'stock_movements']]],
    ['الموظفين', [['/r/employees', 'الموظفين', 'employees'], ['/attendance', 'الحضور والانصراف', 'attendance'], ['/r/leaves', 'الإجازات', 'leaves']]],
    ['النظام', [['/users', 'المستخدمين والصلاحيات', 'users'], ['/settings', 'الإعدادات', 'users']]],
  ];
%>
<header class="top">
  <button class="menu-btn" onclick="document.body.classList.toggle('nav-open')" aria-label="<%= t('القائمة') %>">☰</button>
  <a href="/" class="brand">🏭 <%= t('إدارة المصنع') %></a>
  <div class="who">
    <a href="<%= langLink[0] %>" class="lang-btn"><%= langLink[1] %></a>
    <span><%= user.full_name || user.username %> <small>(<%= t(ROLES[user.role]) %>)</small></span>
    <a href="/password" class="hide-sm"><%= t('كلمة المرور') %></a>
    <form method="post" action="/logout" class="inline"><button class="link"><%= t('خروج') %></button></form>
  </div>
</header>
<div class="wrap">
<nav class="side">
  <% for (const [g, items] of groups) { const vis = items.filter(i => can(i[2])); if (!vis.length) continue; %>
    <div class="grp"><%= t(g) %></div>
    <% for (const [href, label, , sub] of vis) { const act = href === '/' ? path === '/' : (path === href || path.startsWith(href + '/')); %>
      <a href="<%= href %>" class="<%= act ? 'active' : '' %> <%= sub ? 'sub' : '' %>"><%= sub ? '↳ ' : '' %><%= t(label) %></a>
    <% } %>
  <% } %>
</nav>
<main>
<% if (flash) { %><div class="flash <%= flash.type %>"><%= t(flash.msg) %></div><% } %>
<% } else { %><main class="center"><a href="<%= langLink[0] %>" class="lang-float"><%= langLink[1] %></a><% } %>

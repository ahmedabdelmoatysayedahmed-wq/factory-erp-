<%
const v = row[f.name];
let out = v;
if (v === null || v === undefined || v === '') out = '—';
else if (f.type === 'ref') out = (refs[f.name] || {})[v] || v;
else if (f.type === 'select') { const o = f.options.find(o => o.value === v); out = o ? o.label : v; }
else if (f.fmt === 'int') out = Math.round(v).toLocaleString('en');
else if (f.fmt === 'num' || f.type === 'number') out = Number(Number(v).toFixed(2)).toLocaleString('en');
else if (f.fmt === 'pct') out = Number(v).toFixed(0) + '%';
%><% if (f.type === 'select') { %><span class="tag t-<%= v %>"><%= out %></span><% } else if (f.fmt === 'pct') { %><div class="bar"><span style="width:<%= Math.min(100, v) %>%"></span><em><%= out %></em></div><% } else { %><%= out %><% } %>
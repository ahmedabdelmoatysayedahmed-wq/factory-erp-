<%- include('partials/header', { title: 'تقارير الإنتاجية' }) %>
<% const n = (x) => Number(Number(x || 0).toFixed(1)).toLocaleString('en'); %>
<div class="head"><h1>تقارير الإنتاجية</h1></div>
<form class="filters card" method="get">
  <label>من <input type="date" name="from" value="<%= from %>"></label>
  <label>إلى <input type="date" name="to" value="<%= to %>"></label>
  <button class="btn">عرض</button>
  <button type="button" class="btn" onclick="window.print()">طباعة</button>
</form>

<section class="card">
  <h2>إنتاجية الموظفين</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>الموظف</th><th>أيام حضور</th><th>غياب</th><th>تأخير</th><th>أيام إنتاج</th><th>الإنتاج</th><th>الهالك</th><th>نسبة الهالك</th><th>الساعات</th><th>قطعة/ساعة</th><th>متوسط يومي</th><th>تحقيق المستهدف</th></tr></thead>
    <tbody>
    <% for (const e of byEmployee) { const avg = e.days ? e.produced / e.days : 0; const ach = e.daily_target && e.days ? avg * 100 / e.daily_target : null; const sp = e.produced + e.scrap ? e.scrap * 100 / (e.produced + e.scrap) : 0; %>
      <tr><td><%= e.code || '' %> <%= e.name %></td><td><%= e.att_days %></td><td><%= e.abs_days %></td><td><%= e.late_days %></td><td><%= e.days %></td>
      <td><b><%= n(e.produced) %></b></td><td><%= n(e.scrap) %></td><td class="<%= sp > 5 ? 'warn' : '' %>"><%= sp.toFixed(1) %>%</td><td><%= n(e.hours) %></td>
      <td><%= e.hours ? n(e.produced / e.hours) : '—' %></td><td><%= n(avg) %></td>
      <td><% if (ach === null) { %>—<% } else { %><div class="bar <%= ach < 80 ? 'low' : '' %>"><span style="width:<%= Math.min(100, ach) %>%"></span><em><%= ach.toFixed(0) %>%</em></div><% } %></td></tr>
    <% } %>
    </tbody>
  </table></div>
</section>

<section class="card">
  <h2>إنتاجية الماكينات</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>الماكينة</th><th>ساعات التشغيل</th><th>دقائق التوقف</th><th>الإنتاج</th><th>الهالك</th><th>قطعة/ساعة</th><th>الطاقة</th><th>الكفاءة</th><th>الإتاحية</th></tr></thead>
    <tbody>
    <% for (const m of byMachine) { const eff = m.hourly_capacity && m.hours ? m.produced * 100 / (m.hourly_capacity * m.hours) : null; const avail = m.hours ? (m.hours * 60 - m.downtime) * 100 / (m.hours * 60) : null; %>
      <tr><td><%= m.code || '' %> <%= m.name %></td><td><%= n(m.hours) %></td><td><%= n(m.downtime) %></td><td><b><%= n(m.produced) %></b></td><td><%= n(m.scrap) %></td>
      <td><%= m.hours ? n(m.produced / m.hours) : '—' %></td><td><%= m.hourly_capacity ? n(m.hourly_capacity) : '—' %></td>
      <td><% if (eff === null) { %>—<% } else { %><div class="bar <%= eff < 80 ? 'low' : '' %>"><span style="width:<%= Math.min(100, eff) %>%"></span><em><%= eff.toFixed(0) %>%</em></div><% } %></td>
      <td><%= avail === null ? '—' : avail.toFixed(0) + '%' %></td></tr>
    <% } %>
    </tbody>
  </table></div>
  <p class="muted">الكفاءة = الإنتاج ÷ (الطاقة × ساعات التشغيل). الإتاحية = وقت التشغيل الفعلي بعد خصم التوقفات.</p>
</section>

<section class="card">
  <h2>الإنتاج اليومي</h2>
  <% const max = Math.max(1, ...daily.map(x => x.produced + x.scrap)); %>
  <div class="chart">
  <% for (const x of daily) { %>
    <div class="row"><span class="d"><%= x.date.slice(5) %></span>
      <div class="b"><i class="p" style="width:<%= x.produced * 100 / max %>%"></i><i class="s" style="width:<%= x.scrap * 100 / max %>%"></i></div>
      <span class="v"><%= n(x.produced) %><% if (x.scrap) { %> <small>+<%= n(x.scrap) %> هالك</small><% } %></span></div>
  <% } %>
  <% if (!daily.length) { %><p class="empty">لا يوجد إنتاج مسجل في الفترة دي</p><% } %>
  </div>
</section>
<%- include('partials/footer') %>
